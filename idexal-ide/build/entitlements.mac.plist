<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- ============================================ -->
    <!-- Code Signing Entitlements for Notarization   -->
    <!-- ============================================ -->

    <!-- Allow JIT compilation (required for V8/Chromium) -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- Allow unsigned executable memory (required for Electron) -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- Allow DYLD environment variables (required for Node.js) -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>

    <!-- ============================================ -->
    <!-- Network Entitlements                        -->
    <!-- ============================================ -->

    <!-- Allow outgoing network connections (AI APIs, updates) -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- Allow incoming network connections (local server, collaboration) -->
    <key>com.apple.security.network.server</key>
    <true/>

    <!-- ============================================ -->
    <!-- File System Entitlements                    -->
    <!-- ============================================ -->

    <!-- Allow read/write to user-selected files (Open/Save dialogs) -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- Allow read/write to Downloads folder -->
    <key>com.apple.security.files.downloads.read-write</key>
    <true/>

    <!-- Allow access to documents folder -->
    <key>com.apple.security.files.documents.read-write</key>
    <true/>

    <!-- ============================================ -->
    <!-- Device Entitlements                          -->
    <!-- ============================================ -->

    <!-- Camera access (disabled by default) -->
    <key>com.apple.security.device.camera</key>
    <false/>

    <!-- Microphone access (disabled by default) -->
    <key>com.apple.security.device.microphone</key>
    <false/>

    <!-- USB access (for device debugging) -->
    <key>com.apple.security.device.usb</key>
    <false/>

    <!-- Bluetooth access -->
    <key>com.apple.security.device.bluetooth</key>
    <false/>

    <!-- ============================================ -->
    <!-- App Sandbox (disabled for full filesystem)   -->
    <!-- ============================================ -->

    <!-- App Sandbox is disabled to allow full filesystem access -->
    <!-- This is required for an IDE that needs to read/write any file -->
    <key>com.apple.security.app-sandbox</key>
    <false/>
</dict>
</plist>
