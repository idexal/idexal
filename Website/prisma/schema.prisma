// Idexal Website — Prisma schema
// Local dev: SQLite (file:./dev.db)  |  Production: PostgreSQL (DATABASE_URL)
// Switch provider + run `npx prisma migrate dev` when deploying.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ───────────────────────── Users & Auth ─────────────────────────

enum Role {
  USER
  DEVELOPER
  TEAM
  MANAGER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  BANNED
  PENDING
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  name          String
  passwordHash  String
  role          Role       @default(USER)
  status        UserStatus @default(PENDING)
  country       String?
  bio           String?
  website       String?
  avatarUrl     String?
  emailVerified Boolean    @default(false)
  twoFactor     Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  accounts      Account[]
  sessions      Session[]
  apiKeys       ApiKey[]
  subscriptions Subscription[]
  invoices      Invoice[]
  usageRecords  UsageRecord[]
  projects      Project[]
  plugins       Plugin[]
  supportTickets SupportTicket[]
  notifications Notification[]
  sessions2     AuthSession[]

  @@index([email])
  @@index([status])
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  provider          String // google | github | discord
  providerAccountId String
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  sessionToken String   @unique
  expires      DateTime
  ip           String?
  userAgent    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  device    String?
  ip        String?
  lastSeen  DateTime @default(now())
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ───────────────────────── API & Models ─────────────────────────

model ApiKey {
  id          String    @id @default(cuid())
  userId      String
  name        String
  keyHash     String    @unique
  keyPreview  String // sk-…8f2d
  // OmniRoute gateway linkage (api.idexal.com). The gateway twin is
  // provisioned automatically when the local key is created; `synced`
  // flips to true once the gateway confirms creation.
  gatewayKeyId  String? @unique // OmniRoute /api/keys id
  gatewayPreview String? // OmniRoute keyPreview (last 4)
  synced        Boolean @default(false)
  monthlyBudgetUsd Float @default(5)
  lastUsedAt  DateTime?
  revoked     Boolean   @default(false)
  createdAt   DateTime  @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  usageRecords UsageRecord[]

  @@index([userId])
}

model UsageRecord {
  id             String   @id @default(cuid())
  userId         String
  apiKeyId       String?
  model          String // idexal-pro | idexal-lite | idexal-code | idexal-embed
  promptTokens   Int
  completionTokens Int
  costUsd        Float
  // Mirrored from OmniRoute usage history during periodic sync.
  source         String   @default("local") // local | omniroute
  createdAt      DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKey ApiKey? @relation(fields: [apiKeyId], references: [id])

  @@index([userId, createdAt])
  @@index([model])
}

// ───────────────────────── Billing ─────────────────────────

enum PlanTier {
  FREE
  PRO
  TEAM
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String
  tier      PlanTier           @default(FREE)
  status    SubscriptionStatus @default(ACTIVE)
  seats     Int                @default(1)
  currentPeriodEnd DateTime
  stripeSubscriptionId String? @unique
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@index([userId])
  @@index([status])
}

enum InvoiceStatus {
  PAID
  FAILED
  REFUNDED
  OPEN
}

model Invoice {
  id          String        @id @default(cuid())
  userId      String
  number      String        @unique
  amountUsd   Float
  status      InvoiceStatus @default(OPEN)
  method      String? // visa_4242 | paypal | crypto
  stripeInvoiceId String?   @unique
  periodStart DateTime?
  periodEnd   DateTime?
  createdAt   DateTime      @default(now())

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription  Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  subscriptionId String?

  @@index([userId])
  @@index([status])
}

// ───────────────────────── Projects & Plugins ─────────────────────────

model Project {
  id        String   @id @default(cuid())
  userId    String
  name      String
  language  String?
  files     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum PluginStatus {
  LIVE
  REVIEW
  DRAFT
  REJECTED
}

model Plugin {
  id          String       @id @default(cuid())
  authorId    String
  name        String
  slug        String       @unique
  description String
  version     String       @default("1.0.0")
  priceUsd    Float        @default(0)
  installs    Int          @default(0)
  rating      Float        @default(0)
  revenueUsd  Float        @default(0)
  status      PluginStatus @default(DRAFT)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([status])
}

// ───────────────────────── Support & Content ─────────────────────────

enum TicketStatus {
  OPEN
  PENDING
  RESOLVED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
}

model SupportTicket {
  id        String         @id @default(cuid())
  userId    String
  subject   String
  body      String
  status    TicketStatus   @default(OPEN)
  priority  TicketPriority @default(MEDIUM)
  assigneeId String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

model BlogPost {
  id        String   @id @default(cuid())
  slug      String   @unique
  titleEn   String
  titleAr   String
  excerptEn String
  excerptAr String
  bodyEn    String
  bodyAr    String
  category  String // Product | Engineering | Tutorials
  author    String
  readMinutes Int    @default(5)
  published Boolean  @default(false)
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}
