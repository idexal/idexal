{
  "name": "@idexal/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Main CLI application for idexal",
  "bin": {
    "idexal": "./dist/idexal.cjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/idexal.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:desktop-agent": "node scripts/build.mjs --desktop-agent",
    "build:sea": "pnpm --dir ../../../.. exec turbo --skip-infer --cwd apps/idexal-cli run build --filter=!@idexal/cli --force && pnpm build && node scripts/build-sea.mjs --all",
    "sea": "node scripts/build-sea.mjs",
    "upload:sea": "node scripts/upload-sea-smb.mjs",
    "clean": "node ../../scripts/clean-dist.mjs",
    "dev": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "lint:fix": "oxlint --write src"
  },
  "dependencies": {
    "@idexal/adapters": "workspace:*",
    "@idexal/bootstrap": "workspace:*",
    "@idexal/contracts": "workspace:*",
    "@idexal/core": "workspace:*",
    "@idexal/dynamic-workflow-runtime": "workspace:*",
    "@idexal/i18n": "workspace:*",
    "@idexal/provider-node": "workspace:*",
    "@idexal/shared": "workspace:*",
    "@idexal/shared-types": "workspace:*",
    "@idexal/tui": "workspace:*",
    "dotenv": "^17.4.2",
    "playwright-core": "1.59.1"
  }
}
